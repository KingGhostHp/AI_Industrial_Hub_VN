# ============================================
# MAPBOX CONFIGURATION
# ============================================
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ============================================
# IIP VIETNAM API
# ============================================
IIP_VIETNAM_API_URL=https://api.iipvietnam.vn/files/filedata/dataIndustrial_2d6e5ca9-40c0-4785-979b-058c76049677.json

# ============================================
# LLM API CONFIGURATION (AI Investment Advisor)
# ============================================

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=500

# --- LLM Provider Selection ---
# Options: 'gemini', 'openai', or 'anthropic'
LLM_PROVIDER=gemini

# --- LLM API Rate Limiting ---
LLM_MAX_CALLS_PER_HOUR=100

# --- LLM Response Caching ---
LLM_CACHE_TTL=86400

# --- LLM Fallback ---
LLM_ENABLE_FALLBACK=true

# ============================================
# APPLICATION CONFIGURATION
# ============================================
DEFAULT_LANGUAGE=vi
DEBUG_MODE=false
LOCALSTORAGE_MAX_SIZE=5242880
